# Jev (TypeSafe) — required for Jev / Compare
TYPESAFE_API_KEY=
# Alias also accepted: TYPE_SAFE_API_KEY=

# Optional TypeSafe host override (default https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Alias: TYPE_SAFE_BASE_URL=

# Drex — both required for Drex / Compare
DREX_API_KEY=
# System One root only (https://…). Do not append /v1/systemone — the app adds it.
# There is no working public default; api.drex.ai does not resolve (ENOTFOUND).
# Set to your tenant host. Missing → JSON 503; upstream DNS fail → JSON 502.
DREX_BASE_URL=
