# Jev (TypeSafe) — required for Jev / Compare
TYPESAFE_API_KEY=

# Optional TypeSafe host override (default https://api.typesafe.ai)
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Drex — required for Drex / Compare
DREX_API_KEY=

# Optional Drex host override (default https://api.drex.ai)
# Set this if your Drex tenant uses a different System One base URL.
# Do not include /v1/systemone — the app appends it.
# DREX_BASE_URL=https://api.drex.ai
